{
  "_version": "1.6.0",
  "sap.app": {
    "id": "gc.agr.aafc.mm.eqauditmng",
    "type": "application",
    "i18n": "i18n/i18n.properties",
    "applicationVersion": {
      "version": "0.0.1"
    },
    "title": "{{appTitle}}",
    "description": "{{appDescription}}",
    "resources": "resources.json",
    "sourceTemplate": {
      "id": "@sap/generator-fiori:lrop",
      "version": "1.20.4",
      "toolsId": "981234cc-ece1-4e7d-bef7-0e7650b6d3eb"
    },
    "dataSources": {
      "annotation": {
        "type": "ODataAnnotation",
        "uri": "annotations/annotation.xml",
        "settings": {
          "localUri": "annotations/annotation.xml"
        }
      },
      "mainService": {
        "uri": "/sap/opu/odata4/sap/zqmm_ui_audit_header_v4/srvd/sap/zqmm_ui_audit_header/0001/",
        "type": "OData",
        "settings": {
          "annotations": [
            "annotation"
          ],
          "localUri": "localService/mainService/metadata.xml",
          "odataVersion": "4.0"
        }
      }
    }
  },
  "sap.ui": {
    "technology": "UI5",
    "icons": {
      "icon": "",
      "favIcon": "",
      "phone": "",
      "phone@2": "",
      "tablet": "",
      "tablet@2": ""
    },
    "deviceTypes": {
      "desktop": true,
      "tablet": true,
      "phone": true
    }
  },
  "sap.ui5": {
    "flexEnabled": true,
    "dependencies": {
      "minUI5Version": "1.120.47",
      "libs": {
        "sap.m": {},
        "sap.ui.core": {},
        "sap.fe.templates": {},
        "sap.f": {}
      }
    },
    "contentDensities": {
      "compact": true,
      "cozy": true
    },
    "models": {
      "i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      },
      "": {
        "dataSource": "mainService",
        "preload": true,
        "settings": {
          "operationMode": "Server",
          "autoExpandSelect": true,
          "earlyRequests": true
        }
      },
      "@i18n": {
        "type": "sap.ui.model.resource.ResourceModel",
        "uri": "i18n/i18n.properties"
      }
    },
    "resources": {
      "css": []
    },
    "routing": {
      "config": {
        "flexibleColumnLayout": {
          "defaultTwoColumnLayoutType": "TwoColumnsBeginExpanded",
          "defaultThreeColumnLayoutType": "ThreeColumnsMidExpanded"
        },
        "routerClass": "sap.f.routing.Router"
      },
      "routes": [
        {
          "pattern": ":?query:",
          "name": "ZQMM_C_Audit_HeaderList",
          "target": [
            "ZQMM_C_Audit_HeaderList"
          ]
        },
        {
          "pattern": "ZQMM_C_Audit_Header({key}):?query:",
          "name": "ZQMM_C_Audit_HeaderObjectPage",
          "target": [
            "ZQMM_C_Audit_HeaderList",
            "ZQMM_C_Audit_HeaderObjectPage"
          ]
        }
      ],
      "targets": {
        "ZQMM_C_Audit_HeaderList": {
          "type": "Component",
          "id": "ZQMM_C_Audit_HeaderList",
          "name": "sap.fe.templates.ListReport",
          "options": {
            "settings": {
              "contextPath": "/ZQMM_C_Audit_Header",
              "variantManagement": "Page",
              "navigation": {
                "ZQMM_C_Audit_Header": {
                  "detail": {
                    "route": "ZQMM_C_Audit_HeaderObjectPage"
                  }
                }
              },
              "controlConfiguration": {
                "@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "type": "ResponsiveTable"
                  }
                }
              }
            }
          },
          "controlAggregation": "beginColumnPages",
          "contextPattern": ""
        },
        "ZQMM_C_Audit_HeaderObjectPage": {
          "type": "Component",
          "id": "ZQMM_C_Audit_HeaderObjectPage",
          "name": "sap.fe.templates.ObjectPage",
          "options": {
            "settings": {
              "entitySet": "ZQMM_C_Audit_Header",
              "editableHeaderContent": false,
              "enhanceI18n": "i18n/i18n.properties",
              "content": {
                "header": {
                  "actions": {
                    "UpdateDefaultValues": {
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onUpdateDefaultValues",
                      "text": "Update Default Values",
                      "visible": "{= ${isEditable} && ${ApplyDefaults} }",
                      "enabled": true
                    },
                    "ApproveAllItems": {
                      "id": "ApproveAllItems",
                      "requiresSelection": false,
                      "text": "Approve Items",
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onApproveAllItems",
                      "visible": "{= ${isEditable} && ${isSupervisor} }",
                      "enabled": true,
                      "icon": "sap-icon://refresh"
                    },
                    "PostAuditDocument": {
                      "text": "Post to EMR {isCompletable}",
                      "type": "Emphasized",
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onPostAuditDocument",
                      "visible": "{= ${isEditable} && ${isSupervisor} }",
                      "enabled": "{isCompletable}"
                    }
                    
                  }
                }
              },
              "controlConfiguration": {
                "_AuditItems/@com.sap.vocabularies.UI.v1.LineItem": {
                  "tableSettings": {
                    "enableSearch": true,
                    "type": "ResponsiveTable",
                    "rowPress": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onItemRowPress",
                    "groupBy": "" ,
                    "selectionMode": "Multi",

                    "quickVariantSelection": {
                      "showCounts": true,
                      "hideTableTitle": false,
                      "paths": [
                        {
                          "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#spv0",
                          "keepPreviousSelection": true,
                          "tableSettings": {
                            "groupBy": ""   
                          }
                        },
                        {
                          "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#spv1",
                          "keepPreviousSelection": true,
                          "tableSettings": {
                            "groupBy": ""   
                          }
                        },
                        {
                          "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#spv2",
                          "keepPreviousSelection": true,
                          "tableSettings": {
                            "groupBy": ""   
                          }
                        },
                        {
                          "annotationPath": "com.sap.vocabularies.UI.v1.SelectionPresentationVariant#spv3",
                          "keepPreviousSelection": true,
                          "tableSettings": {
                            "groupBy": ""   
                          }
                        }
                      ]
                    }
                  },
                  "navigation": {
                    "ZQMM_C_Audit_Items": {
                      "detail": {
                        "route": ""  
                      }
                    }
                  },
                  
                  
                  "actions": {
                    "EditItem": {
                      "id": "EditItem ",
                      "requiresSelection": true,
                      "text": "Edit Item",
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onEditEquipmentValues",
                      "visible": "{isEditable}",
                      "enabled": "{= ${isEditable} === true && ${ui>/showEdit} === true }"
                    },
                    "ApproveMultipleItems": {
                      "id": "ApproveMultipleItems",
                      "requiresSelection": true,
                      "text": "Approve Items",
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onApproveMultipleItems",
                      "visible": false,
                      "enabled": "{isCompletable}"
                    },
                    "NotInSAP": {
                      "id": "NotInSAP",
                      "requiresSelection": false,
                      "text": "Not in SAP",
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onNotInSAPPress",
                      "visible": true,
                      "enabled": "{isEditable}"
                    },
                    "BarcodeScan": {
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onBarcodeScan",
                      "visible": true,
                      "enabled": true,
                      "requiresSelection": false,
                      "text": "Barcode Scan"
                    },
                    "AddEquipment": {
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onAddEquipmentOpen",
                      "text": "Add Equipment",
                      "enabled": true,
                      "position": {
                        "placement": "After",
                        "anchor": "EditItem"
                      }
                    },
                    "ClearSearchFilterAction": {
                      "text": "Refresh",
                      "press": ".extension.gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt.onClearSearchFilter",
                      "requiresSelection": false,
                      "visible": true,
                      "icon": "sap-icon://refresh",
                      "position": {
                        "placement": "Before",
                        "anchor": "EditItem"
                      }
                    }
                  }
                }
              }
            }
          },
          "controlAggregation": "midColumnPages",
          "contextPattern": "/ZQMM_C_Audit_Header({key})"
        }
      }
    },
    "extends": {
      "extensions": {
        "sap.ui.controllerExtensions": {
          "sap.fe.templates.ListReport.ListReportController": {
            "controllerName": "gc.agr.aafc.mm.eqauditmng.ext.controller.AuditHeaderListExt"
          },
          "sap.fe.templates.ObjectPage.ObjectPageController": {
            "controllerName": "gc.agr.aafc.mm.eqauditmng.ext.controller.ObjectExt"
          }
        }
      }
    },
    "rootView": {
      "viewName": "sap.fe.templates.RootContainer.view.Fcl",
      "type": "XML",
      "async": true,
      "id": "appRootView"
    }
  },
  "sap.fiori": {
    "registrationIds": [],
    "archeType": "transactional"
  },
  "sap.fe": {
    "app": {
      "enableLazyLoading": true
    }
  }
}
