<!-- z.audit.ext.fragment.ManualSearchPopover -->
<core:FragmentDefinition xmlns="sap.m" xmlns:core="sap.ui.core">
  <Popover
    id="manualSearchPopover"
    title="Search Equipment"
    placement="Bottom"
    showHeader="true">
    <content>
      <HBox alignItems="Center" class="sapUiSmallMargin">
        <SearchField
          id="manualSearchInput"
          placeholder="Equipment Number"
          width="16rem"
          enableSuggestions="true"
          search=".onManualSearchEquipment" />
      <!-- </HBox visible="{ui>/showSearchNotFound}">
        <Text ></Text>
      <HBox > -->
      </HBox>
    </content>
  </Popover>
</core:FragmentDefinition>