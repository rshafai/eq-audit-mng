<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core">

    <Dialog
        id="idAddItemDialog"
        title="Confirm New Item"
        contentWidth="38rem">

        <content>
            <VBox class="sapUiSmallMargin">

                <Text
                    text="Asset {addItem>/Equipment} is not in this Audit, but was found in SAP master data:"
                    class="sapUiMediumMarginBottom" />

                <!-- Equipment -->
                <HBox class="sapUiTinyMarginBottom">
                    <Label design="Bold"
                        text="Equipment"
                        width="8rem" />
                    <Text
                        text="{addItem>/Equipment} - {addItem>/EquipmentName}"
                        class="sapUiTinyMarginBegin" />
                </HBox>

                <!-- Maintenance Plant -->
                <HBox class="sapUiTinyMarginBottom">
                    <Label design="Bold"
                        text="Maint. Plant" 
                        width="8rem" />
                    <Text 
                        text="{addItem>/MaintenancePlant} - {addItem>/MaintenancePlantName}"
                        class="sapUiTinyMarginBegin" />
                </HBox>

                <!-- Asset Location -->
                <HBox class="sapUiTinyMarginBottom">
                    <Label design="Bold"
                        text="Asset Location"
                        width="8rem" />
                    <Text
                        text="{addItem>/AssetLocation} - {addItem>/AssetLocationName}"
                        class="sapUiTinyMarginBegin" />
                </HBox>

                <!-- Asset Room -->
                <HBox class="sapUiTinyMarginBottom">
                    <Label design="Bold"
                        text="Asset Room"
                        width="8rem" />
                    <Text
                        text="{addItem>/AssetRoom}"
                        class="sapUiTinyMarginBegin" />
                </HBox>

                <Text
                    text="Would you like to add this equipment to the Audit?"
                    class="sapUiSmallMarginTop sapUiSmallMarginBottom" />

            </VBox>
        </content>

        <footer>
            <OverflowToolbar>
                <CheckBox
                    id="idRememberMe"
                    text="Bypass this popup in future"
                    selected="{addItem>/suppressConfirmation}" />

                <ToolbarSpacer />

                <Button
                    text="Add to Audit"
                    press=".onAddItemConfirmed"
                    type="Emphasized" />

                <Button
                    text="Retry Scan"
                    press=".onBarcodeScan" />

                <Button
                    text="Cancel"
                    press=".onCancelAddItem" />
            </OverflowToolbar>
        </footer>

    </Dialog>
</core:FragmentDefinition>