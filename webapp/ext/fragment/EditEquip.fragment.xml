<c:FragmentDefinition
	xmlns="sap.m"
	xmlns:c="sap.ui.core"
>

<Dialog id="editEquipDialog" 
      title="Edit Equipment: {itemCtx>Equipment}-{itemCtx>EquipmentName}" 
      initialFocus="idButtonSave" 
      state="None"
      draggable="true"
      resizable="true"
      contentWidth="50%">
      <customHeader>
        <Bar >
            <contentLeft>
              <Text text="Edit Equipment" />
                <!-- Add optional icon or back button here -->
            </contentLeft>
            <contentMiddle>
              <Text text="{dlg>/exceptionType}"></Text>
              <MessageStrip type="Error" text="Exception Declared" visible="{= ${dlg>/exceptionType}>'000'  }" class="sapUiTinyMargin" />
                
            </contentMiddle>
            <contentRight>
                <Button icon="sap-icon://decline" press="onCancelEquipDialog"/>
            </contentRight>
        </Bar>
    </customHeader>
  <content>
    <VBox class="sapUiSmallMargin">

      <HBox >
        <VBox class="sapUiMediumMarginEnd">
          <Label text="Audit Item #"></Label>
          <Title text="{itemCtx>AuditDocId}-{itemCtx>ItemNumber}" level="H2" />
        </VBox>
        <VBox class="sapUiMediumMarginEnd">
          <Label text="Audit Item Status"></Label>
          <Title text="{itemCtx>AuditItemStatusText}" level="H2" />
        </VBox>
        <VBox class="sapUiMediumMarginEnd">
          <Label text="Equipment"></Label>
          <Title text="{itemCtx>Equipment} - {itemCtx>EquipmentName}" level="H2" />
        </VBox>
      </HBox>


<!-- Item level fields -->
      <!-- <HBox width="100%">
        <VBox class="sapUiMediumMarginEnd"> -->
          <Label text="Equipment Condition" class="sapUiSmallMarginTop" />
          <Select
            selectedKey="{
              path: 'dlg>/EqCondition', 
              type: 'sap.ui.model.odata.type.String',
              constraints: { isDigitSequence: true, maxLength: 3 }
            }"
            items="{ path: '/EqConditionVH' }">
            <c:Item
              key="{
                path: 'Value',
                type: 'sap.ui.model.odata.type.String',
                constraints: { isDigitSequence: true, maxLength: 3 }
              }"
              text="{Text}" />
          </Select>
        <!-- </VBox> 
        <VBox width="100%">  -->
          <Label text="Auditor's Comments {=( ${dlg>/ExceptionType}>'000' )?'*':''}" class="sapUiTinyMarginTop"/>
          <TextArea value="{dlg>/Comments}" rows="3" width="100%" />

          <Label text="Exception" class="sapUiTinyMarginTop" />
          <Select
            valueState="{= (${dlg>/ExceptionType}>'000')?'Warning':'Success' }"
            valueStateText="  "
            selectedKey="{
              path: 'dlg>/ExceptionType',
              type: 'sap.ui.model.odata.type.String',
              constraints: { maxLength: 3 }
            }"
            items="{ path: '/ExceptionTypeVH' }">
            <c:Item
              key="{Value}"
              text="{Text}" />
          </Select>
        <!-- </VBox>     
      </HBox>  -->

      <Table items="{dlg>/fields}" growing="false" visible="{= !(${dlg>/ExceptionType}==='030')}" class="sapUiSmallMarginBottom sapUiSmallMarginTop">
        <columns>
          <Column><Text text="Field" /></Column>
          <Column><Text text="Current Value" /></Column>
          <Column width="30px"></Column>
          <Column><Text text="New Value" /></Column>
        </columns>
        <items >
          <ColumnListItem>
            <cells>
              <Label text="{dlg>label}" design="Bold" />
              <ObjectStatus 
                      text="{dlg>oldValue} - {dlg>oldValueText}" 
                      state="{path: 'dlg>oldValue', formatter: '.formatColumns'}" />

              
              <c:Icon src="sap-icon://restart" color="red" visible="{= ${dlg>oldValue}!==${dlg>newValue} }" press="onRevert"></c:Icon>
              <Input
                value="{dlg>newValue}"
                showValueHelp="{= !!${dlg>valueHelpEntity} }"
                valueHelpRequest=".onGenericVH" />
            </cells>
          </ColumnListItem>
        </items>
      </Table>
    
    </VBox>
  </content>
  <buttons>
    <Button id="idButtonValidate" text="Validate"           visible="{isEditable}"                                  press=".onValidateEquipChanges" type="Ghost" />
    <Button id="idButtonSave"     text="Save"               visible="{isEditable}"                                  press=".onSaveEquipChanges" type="Emphasized" />
    <Button id="idButtonApprove"  text="Save &amp; Approve" visible="{= ${isEditable} &amp;&amp; ${isSupervisor} }" press=".onSaveAndApprove"   type="Success" />
    <Button id="idButtonCancel"   text="Cancel"             visible="true"                                          press=".onCancelEquipDialog" />
  </buttons>
</Dialog>

</c:FragmentDefinition>