<!-- NOT USED  -->
<core:FragmentDefinition
    xmlns="sap.m"
    xmlns:core="sap.ui.core"
    xmlns:f="sap.ui.layout.form"
    xmlns:macros="sap.fe.macros">


<Dialog id="changeEquiDialog" 
    title="Edit Equipment Properties" 
    contentWidth="650px"
    beforeOpen="onDialogBeforeOpen"
    afterOpen="onDialogAfterOpen"
    afterClose="onAfterClose"
    >
        <customHeader>
            <Bar id="idBar">
                <contentLeft>
                    <Title id="idTitle" text="Edit Equipment {Equipment}"/>
                </contentLeft>
                
                <contentRight>
                    <ObjectStatus id="txtStatus" text="Active Status" state="Information" />
                </contentRight>
            </Bar>
        </customHeader>
        <content>

        <f:SimpleForm id="idFormChange" editable="true" layout="ResponsiveGridLayout">
        <f:content>
            <Label id="idLblMaintPlant" text="Maintenance Plant" required="false" />
            <HBox alignItems="Center" displayInline="true">
                <Input id="idMaintPlant" value="{MaintenancePlant}" showValueHelp="true" valueHelpRequest="onValueHelp" class="sapUiTinyMarginEnd"/>
                <Label text=" "  class="sapUiTinyMarginEnd" />
                <Text text="{path: 'localBufferModel>/MaintenancePlant', mode: 'OneWay'}" class="sapUiMediumMarginEnd" style="Bold" />
            </HBox>
            <!-- <Label id="idLblLocation" text="Location" />
            <Input id="idLocation" value="{AssetLocation}" showValueHelp="true" valueHelpRequest="onValueHelp"></Input> -->

            <Label id="idlblSerial" text="Serial Number" />
            <HBox alignItems="Center" displayInline="true">
                <Input id="idSerial" value="{ManufacturerSerialNumber}" showValueHelp="true" valueHelpRequest="onValueHelp" class="sapUiTinyMarginEnd"/>
                <Label text="   " class="sapUiTinyMarginEnd" />
                <Text text="{path: 'ManufacturerSerialNumber', mode: 'OneWay'}" class="sapUiMediumMarginEnd" style="Bold" />
            </HBox>


            <Label id="idlblMfgName" text="Manufacturer" />
            <HBox alignItems="Center" displayInline="true">
                <Input id="idMfgName" value="{AssetManufacturerName}" showValueHelp="true" valueHelpRequest="onValueHelp" class="sapUiTinyMarginEnd"/>
                <Label text="   " class="sapUiTinyMarginEnd" />
                <Text text="{path: 'AssetManufacturerName', mode: 'OneWay'}" class="sapUiMediumMarginEnd" style="Bold" />
            </HBox>

            <!-- <macros:Field id="fldPlant" 
                            metaPath="EquipmentName" 
                            readOnly="true" />     -->
                            
        </f:content>
        </f:SimpleForm>

        </content>
        <buttons>
            <Button text="Save" type="Emphasized" id="btnSave" press=".onSaveEquipmentChanges" />
            <Button text="Cancel" id="btnCancel" press=".onCloseEquipmentDialog" />
        </buttons>
    </Dialog>
    
</core:FragmentDefinition>
