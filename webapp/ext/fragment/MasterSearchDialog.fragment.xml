<core:FragmentDefinition
  xmlns="sap.m"
  xmlns:core="sap.ui.core">

  <SelectDialog
    id="masterSearchDialog"
    title="Search Equipment Master"
    search=".onMasterSearch"
    confirm=".onMasterSearchConfirm"
    cancel=".onMasterSearchCancel"
    draggable="true"
    resizable="true"
    searchPlaceholder="Search by Equipment #, Description, Serial Number,..."
    noDataText="No equipment found. Please refine your search."
    growing="true"
    growingThreshold="50"
    contentWidth="40rem">

